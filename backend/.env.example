# Browser origins allowed to call the API (comma-separated). Include local Next.js and any
# Azure Container Apps (or custom domain) frontend URL — CORS matches origin, not path.
# Example: http://localhost:3900,https://your-frontend.region.azurecontainerapps.io
CORS_ORIGINS=http://localhost:3900,http://127.0.0.1:3900

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
LITELLM_API_BASE=
LITELLM_MASTER_KEY=
LLM_GATEWAY_ENABLE_PAID_TESTS=false
LLM_GATEWAY_DAILY_BUDGET=10
LLM_GATEWAY_DEFAULT_CHEAP_MODEL=gpt-4o-mini
LLM_GATEWAY_DEFAULT_REASONING_MODEL=gpt-4o
LLM_GATEWAY_DEFAULT_FALLBACK_MODEL=local-placeholder
DATABASE_URL=
EMBEDDINGS_PROVIDER=placeholder
EMBEDDINGS_MODEL=placeholder-hash-embedding
EMBEDDINGS_ENABLE_PAID_CALLS=false
VECTOR_MEMORY_ENABLED=true

# Alpaca paper account / market data / MCP
ALPACA_API_KEY=PK4XHWXJILVR4UKUAI4EHXUNXU
ALPACA_SECRET_KEY=BNrvXnFUEtHiSSiEQaRx3t9xR3zjKfQA2cPTmShnZxte
ALPACA_PAPER_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_BASE_URL=https://data.alpaca.markets
ALPACA_MARKET_DATA_ENABLED=false
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false
BROKER_EXECUTION_ENABLED=false
ALPACA_PAPER_TRADE=true

# EdgeSense execution workflow (paper-first; live requires explicit flags)
EDGESENSE_EXECUTION_MODE=paper
EDGESENSE_LIVE_TRADING_ENABLED=false
EDGESENSE_REQUIRE_HUMAN_APPROVAL=true
EDGESENSE_MAX_DAILY_LOSS_PCT=2.0
EDGESENSE_MAX_TRADE_RISK_PCT=0.5
EDGESENSE_MAX_OPEN_POSITIONS=3
EDGESENSE_MAX_SYMBOL_EXPOSURE_PCT=20
EDGESENSE_ALLOWED_ASSET_CLASSES=stocks,options,crypto
EDGESENSE_DEFAULT_ORDER_TYPE=limit
EDGESENSE_MAX_SPREAD_PCT=0.5
EDGESENSE_MAX_SLIPPAGE_PCT=0.25
EDGESENSE_ORDER_TIMEOUT_SECONDS=60

# LangSmith Tracing (Optional)
# See docs/LANGSMITH_SETUP.md for details
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=edgesenseai
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# DeepAgents advisory reasoning + agent capability gates.
# Code default for AGENT_REASONING_ENABLED is false (opt-in). The example here is true
# so a fresh local clone exercises the advisory layer. LIVE order submission is also
# force-gated by LIVE_TRADING_ENABLED and BROKER_EXECUTION_ENABLED, regardless of
# AGENT_CAN_SUBMIT_LIVE_ORDERS.
AGENT_REASONING_ENABLED=true
AGENT_CAN_RECOMMEND_TRADES=true
AGENT_CAN_CREATE_PAPER_PLANS=true
AGENT_CAN_CREATE_APPROVAL_REQUESTS=true
AGENT_CAN_SUBMIT_PAPER_ORDERS=true
AGENT_CAN_AUTO_SUBMIT_PAPER_ORDERS=false
AGENT_CAN_SUBMIT_LIVE_ORDERS=false

