# Copy to .env.local for local dev, or set the same keys in Vercel → Environment Variables (Production).

# Azure backend (public URL — browser control tower + server proxy target)
NEXT_PUBLIC_API_URL=https://edgesenseai-backend.braveisland-a2c39ffe.centralus.azurecontainerapps.io
BACKEND_BASE_URL=https://edgesenseai-backend.braveisland-a2c39ffe.centralus.azurecontainerapps.io

# Must match OPS_ADMIN_TOKEN on the Azure Container App (server-only; never NEXT_PUBLIC_*)
OPS_ADMIN_TOKEN=

# NextAuth (frontend only — not Azure backend)
NEXTAUTH_URL=https://edge-sense-ai.vercel.app
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
